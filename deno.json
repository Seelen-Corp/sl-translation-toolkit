{
  "name": "@seelen/translation-toolkit",
  "description": "Seelen Translation Toolkit",
  "version": "1.2.3",
  "license": "Apache-2.0",
  "tasks": {
    "build": "deno run -A ./scripts/build.ts",
    "version": "deno run -A ./scripts/version.ts"
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.42.3",
    "deepl-node": "npm:deepl-node@^1.26.0",
    "google-translate-api-x": "npm:google-translate-api-x@^10.7.2",
    "mdast": "npm:mdast@^3.0.0",
    "remark": "npm:remark@^15.0.1",
    "remark-frontmatter": "npm:remark-frontmatter@^5.0.0",
    "remark-gfm": "npm:remark-gfm@^4.0.1",
    "rfdc": "npm:rfdc@^1.4.1",
    "yaml": "npm:yaml@^2.8.3"
  },
  "exports": "./src/lib.ts",
  "publish": {
    "exclude": [
      ".github",
      "scripts",
      "mocks"
    ]
  },
  "compilerOptions": {
    "noUncheckedIndexedAccess": true
  }
}
